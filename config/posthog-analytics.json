  "insights": [
    {
      "id": 5468194,
      "name": "Workspace activation",
      "description": "Workspace creation cohorts matched to activation by workspace_id, regardless of which teammate activates. Counts creations in the selected date range and activation observed within 30 days; recent cohorts are still maturing.",
      "query": {
        "kind": "DataTableNode",
        "showDateRange": true,
        "showPropertyFilter": true,
        "showTestAccountFilters": true,
        "source": {
          "kind": "HogQLQuery",
          "filters": {
            "dateRange": {
              "date_from": "-30d"
            },
            "properties": [
              {
                "type": "event",
                "key": "environment",
                "operator": "exact",
                "value": ["production"]
              },
              {
                "type": "event",
                "key": "openpost_smoke",
                "operator": "is_not_set"
              },
              {
                "type": "event",
                "key": "$internal_or_test_user",
                "operator": "is_not",
                "value": [true]
              }
            ],
            "filterTestAccounts": true
          },
          "query": "WITH created AS (\n SELECT properties.workspace_id AS workspace_id, min(timestamp) AS created_at\n FROM events\n WHERE event = 'workspace created' AND properties.workspace_id IS NOT NULL AND {filters}\n GROUP BY workspace_id\n), activated AS (\n SELECT properties.workspace_id AS workspace_id, min(timestamp) AS activated_at\n FROM events\n WHERE event = 'workspace activated' AND properties.workspace_id IS NOT NULL\n AND properties.environment = 'production' AND properties.openpost_smoke IS NULL\n AND coalesce(properties.$internal_or_test_user, false) != true\n AND coalesce(person.properties.$internal_or_test_user, false) != true\n GROUP BY workspace_id\n)\nSELECT count() AS created_workspaces,\n countIf(activated.activated_at >= created.created_at AND activated.activated_at <= created.created_at + INTERVAL 30 DAY) AS activated_workspaces,\n round(100.0 * activated_workspaces / nullIf(created_workspaces, 0), 2) AS activation_percent\nFROM created LEFT JOIN activated ON created.workspace_id = activated.workspace_id"
        }
      }
    },
